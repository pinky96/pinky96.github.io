# =============================================================
# Gemfile — dependencias de Ruby para trabajar con el sitio
# EN TU COMPUTADORA. GitHub Pages no usa este archivo: al hacer
# push, construye el sitio con su propia versión de Jekyll.
#
# Para probar el sitio localmente:
#   bundle install            (solo la primera vez)
#   bundle exec jekyll serve  (y abrir http://localhost:4000)
# =============================================================
source "https://rubygems.org"

# El generador de sitios estáticos.
gem "jekyll", "~> 4.4"

# Zonas horarias para Windows y JRuby (no afecta a Linux/Mac).
platforms :mingw, :x64_mingw, :mswin, :jruby do
  gem "tzinfo", ">= 1", "< 3"
  gem "tzinfo-data"
end
